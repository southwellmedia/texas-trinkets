---
/**
 * PageLayout
 * Layout wrapper for standard content pages (404, blog index, etc.).
 * Delegates to SiteLayout so every page shares the Texas Trinkets header/footer.
 */
import SiteLayout from './SiteLayout.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  noindex?: boolean;
  nofollow?: boolean;
}

const { title, description, image, imageAlt, noindex } = Astro.props;
---

<SiteLayout
  title={title}
  description={description}
  image={image}
  imageAlt={imageAlt}
  noindex={noindex}
>
  <div class="min-h-[60vh]">
    <slot />
  </div>
</SiteLayout>
