---
import type { CollectionEntry } from 'astro:content';
import { CATEGORIES } from '@/lib/shots';
import ProductCard from './ProductCard.astro';
import ShopThePhoto from './ShopThePhoto.astro';

interface Props {
  products: CollectionEntry<'products'>[];
}

const { products } = Astro.props;

/** Cards shown before "Show more" (per filter) */
const PAGE = 12;

// "Everything" view: interleave categories so hats, beanies and earrings
// surface early while jewelry (the core line) still leads. Each category
// keeps its own order, so the filtered views are unchanged.
const pattern = ['jewelry', 'jewelry', 'hats', 'beanies', 'earrings'] as const;
const queues: Record<string, typeof products> = Object.fromEntries(
  CATEGORIES.map((c) => [c.key, products.filter((p) => p.data.category === c.key)])
);
const mixed: typeof products = [];
while (pattern.some((k) => queues[k]?.length)) {
  for (const key of pattern) {
    const next = queues[key]?.shift();
    if (next) mixed.push(next);
  }
}
// categories outside the pattern (future additions) are appended as-is
mixed.push(...products.filter((p) => !mixed.includes(p)));

const counts = Object.fromEntries(
  CATEGORIES.map((c) => [c.key, products.filter((p) => p.data.category === c.key).length])
);
const chips = [{ key: 'all', label: 'Everything', count: products.length }].concat(
  CATEGORIES.filter((c) => counts[c.key] > 0).map((c) => ({ ...c, count: counts[c.key] }))
);
---

<section id="shop" class="shop">
  <div class="tt-container">
    <div class="section-head">
      <div data-reveal>
        <div class="eyebrow">Available now</div>
        <h2 class="display">Find your <em>piece.</em></h2>
      </div>
      <p data-reveal style="--d:1">
        Jewelry, earrings, trucker hats and beanies. Every piece is finished in small batches, and
        some designs won’t come around twice.
        <span class="hand shop-note">tap a photo to see every piece ↓</span>
      </p>
    </div>

    <div class="filters" role="group" aria-label="Filter the shop" data-reveal data-shop-filters>
      {
        chips.map((c, i) => (
          <button
            type="button"
            class="chip"
            data-filter={c.key}
            aria-pressed={i === 0 ? 'true' : 'false'}
          >
            {c.label}
            <span class="chip-count" aria-hidden="true">{c.count}</span>
          </button>
        ))
      }
    </div>

    <div class="products" data-shop-grid data-page={PAGE}>
      {
        mixed.map((product, i) => (
          <ProductCard product={product} index={i} collapsed={i >= PAGE} />
        ))
      }
    </div>

    <div class="more" data-shop-more hidden={mixed.length <= PAGE}>
      <button type="button" class="tt-btn tt-btn-line more-btn" data-shop-more-btn>
        Show more <span class="more-count" data-shop-more-count>{mixed.length - PAGE}</span>
      </button>
    </div>
  </div>
</section>

<ShopThePhoto shots={mixed} />

<script>
  const root = document.querySelector<HTMLElement>('[data-shop-filters]');
  const grid = document.querySelector<HTMLElement>('[data-shop-grid]');
  if (root && grid) {
    const chips = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-filter]'));
    const cards = Array.from(grid.querySelectorAll<HTMLElement>('[data-category]'));
    const more = document.querySelector<HTMLElement>('[data-shop-more]');
    const moreBtn = document.querySelector<HTMLButtonElement>('[data-shop-more-btn]');
    const moreCount = document.querySelector<HTMLElement>('[data-shop-more-count]');
    const PAGE = Number(grid.dataset.page) || 12;
    let current = 'all';
    let limit = PAGE;

    const render = () => {
      const list = cards.filter((c) => current === 'all' || c.dataset.category === current);
      cards.forEach((card) => {
        card.hidden = true;
        card.removeAttribute('data-collapsed');
      });
      list.forEach((card, i) => {
        const show = i < limit;
        card.hidden = !show;
        // Re-stagger the reveal delay for the cards that remain visible
        if (show) card.style.setProperty('--d', String(i % 3));
      });
      const left = list.length - limit;
      if (more) more.hidden = left <= 0;
      if (moreCount) moreCount.textContent = String(Math.max(0, left));
      return list;
    };

    const apply = (key: string) => {
      chips.forEach((c) => c.setAttribute('aria-pressed', c.dataset.filter === key ? 'true' : 'false'));
      current = key;
      limit = PAGE;
      render();
    };

    moreBtn?.addEventListener('click', () => {
      const firstNew = limit;
      limit += PAGE;
      const list = render();
      // Move focus to the first newly revealed card for keyboard users
      list[firstNew]?.focus({ preventScroll: true });
    });

    chips.forEach((chip) =>
      chip.addEventListener('click', () => {
        const key = chip.dataset.filter ?? 'all';
        apply(key);
        const url = new URL(location.href);
        if (key === 'all') url.searchParams.delete('shop');
        else url.searchParams.set('shop', key);
        history.replaceState(null, '', url);
      })
    );

    // Deep link: /?shop=hats#shop
    const initial = new URLSearchParams(location.search).get('shop');
    if (initial && chips.some((c) => c.dataset.filter === initial)) apply(initial);
  }
</script>

<style>
  .shop {
    padding: 88px 0 120px;
  }
  .shop-note {
    display: block;
    margin-top: 10px;
    transform: rotate(-3deg);
    transform-origin: left;
  }

  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 30px 0 34px;
  }
  .chip {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 9px 14px 9px 16px;
    border: 1.5px solid rgba(58, 37, 24, 0.18);
    border-radius: 999px;
    background: transparent;
    color: var(--tt-ink);
    font: inherit;
    font-size: 13px;
    font-weight: 750;
    letter-spacing: 0.01em;
    cursor: pointer;
    transition:
      background 0.25s ease,
      border-color 0.25s ease,
      color 0.25s ease,
      transform 0.3s var(--ease-out-soft);
  }
  .chip:hover {
    border-color: var(--tt-leather);
    transform: translateY(-1px);
  }
  .chip:focus-visible {
    outline: 2px solid var(--tt-turquoise);
    outline-offset: 3px;
  }
  .chip[aria-pressed='true'] {
    background: var(--tt-ink);
    border-color: var(--tt-ink);
    color: var(--tt-paper);
  }
  .chip-count {
    font-size: 10.5px;
    font-weight: 800;
    padding: 2px 7px;
    border-radius: 999px;
    background: rgba(58, 37, 24, 0.08);
    color: var(--tt-muted);
  }
  .chip[aria-pressed='true'] .chip-count {
    background: rgba(255, 250, 241, 0.16);
    color: var(--tt-paper);
  }

  .products {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 34px 26px;
  }
  /* Collapsed until "Show more" — only when JS is running, so no-JS
     visitors still see every card. */
  :global(.reveal-ready) .products > :global([data-collapsed]) {
    display: none;
  }

  .more {
    display: flex;
    justify-content: center;
    margin-top: 46px;
  }
  .more[hidden] {
    display: none;
  }
  .more-count {
    display: inline-grid;
    place-items: center;
    min-width: 26px;
    height: 22px;
    padding: 0 7px;
    border-radius: 999px;
    background: var(--tt-sand);
    font-size: 11px;
    font-weight: 800;
  }

  @media (max-width: 960px) {
    .shop {
      padding: 78px 0;
    }
    .products {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 640px) {
    .shop {
      padding: 68px 0;
    }
    .filters {
      margin: 22px 0 24px;
      gap: 6px;
    }
    .chip {
      font-size: 12px;
      padding: 8px 12px 8px 13px;
    }
    .products {
      gap: 13px;
    }
  }
</style>
