---
/**
 * Seal
 * The logo medallion wrapped in slowly rotating circular text —
 * a stamped "maker's mark" used in the hero, story and footer.
 */
import { Image } from 'astro:assets';
import medallion from '@/assets/branding/tt-medallion.png';

interface Props {
  /** Rendered diameter in px */
  size?: number;
  /** Ring text; repeated separators are added automatically */
  text?: string;
  /** Ring + text colour scheme */
  tone?: 'light' | 'dark';
  /** Rotate the ring */
  spin?: boolean;
  class?: string;
}

const {
  size = 170,
  text = 'Handmade in Texas ✦ Made with love, faith & purpose ✦',
  tone = 'light',
  spin = true,
  class: className,
} = Astro.props;

const id = `seal-${Math.random().toString(36).slice(2, 8)}`;
---

<div
  class:list={['seal', `seal--${tone}`, { 'seal--spin': spin }, className]}
  style={`--seal-size:${size}px`}
  role="img"
  aria-label="Texas Trinkets seal: two cowgirls on horseback"
>
  <svg class="seal-ring" viewBox="0 0 200 200" aria-hidden="true">
    <defs>
      <path id={id} d="M100,100 m-80,0 a80,80 0 1,1 160,0 a80,80 0 1,1 -160,0" />
    </defs>
    <circle cx="100" cy="100" r="97" class="seal-disc" />
    <circle cx="100" cy="100" r="92" class="seal-stitch" />
    <text class="seal-text">
      <textPath href={`#${id}`} textLength="500" lengthAdjust="spacing">{text}</textPath>
    </text>
  </svg>
  <div class="seal-center">
    <Image src={medallion} alt="" width={Math.round(size * 1.2)} loading="lazy" />
  </div>
</div>

<style>
  .seal {
    position: relative;
    width: var(--seal-size);
    height: var(--seal-size);
    flex: none;
  }
  .seal-ring {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .seal--spin .seal-ring {
    animation: seal-spin 28s linear infinite;
  }
  .seal-disc {
    fill: var(--tt-paper);
  }
  .seal-stitch {
    fill: none;
    stroke: var(--tt-leather);
    stroke-width: 1;
    stroke-dasharray: 3 3;
    opacity: 0.7;
  }
  .seal-text {
    font-family: var(--font-sans);
    font-size: 12.5px;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    fill: var(--tt-ink);
  }
  .seal--dark .seal-disc {
    fill: var(--tt-leather);
  }
  .seal--dark .seal-stitch {
    stroke: var(--tt-paper);
  }
  .seal--dark .seal-text {
    fill: var(--tt-paper);
  }
  .seal-center {
    position: absolute;
    inset: 22%;
    border-radius: 50%;
    overflow: hidden;
    box-shadow:
      0 0 0 2px var(--tt-ink),
      0 0 0 5px var(--tt-paper);
  }
  .seal--dark .seal-center {
    box-shadow:
      0 0 0 2px var(--tt-paper),
      0 0 0 5px var(--tt-leather-dark);
  }
  .seal-center :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @keyframes seal-spin {
    to {
      transform: rotate(360deg);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .seal--spin .seal-ring {
      animation: none;
    }
  }
</style>
