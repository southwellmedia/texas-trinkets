---
import { getShots, piecesOf } from '@/lib/shots';
import SiteLayout from '@/layouts/SiteLayout.astro';
import Hero from '@/components/sections/Hero.astro';
import Marquee from '@/components/sections/Marquee.astro';
import TrustBar from '@/components/sections/TrustBar.astro';
import ProductGrid from '@/components/sections/ProductGrid.astro';
import CustomOrder from '@/components/sections/CustomOrder.astro';
import MeetSalem from '@/components/sections/MeetSalem.astro';
import Process from '@/components/sections/Process.astro';
import OrderForm from '@/components/sections/OrderForm.astro';

const products = await getShots();
const pieceGroups = products.map((shot) => ({
  label: shot.data.name,
  pieces: piecesOf(shot).map((p) => p.name),
}));
---

<SiteLayout
  title="Handmade Western Jewelry"
  description="Turquoise, silver, conchos and one-of-a-kind finds, made by hand in Texas. Shop available pieces or start a custom order."
>
  <div id="top">
    <Hero />
    <Marquee bleed="var(--hero-ground)" />
    <TrustBar />
    <ProductGrid products={products} />
    <CustomOrder />
    <MeetSalem />
    <Process />
    <OrderForm groups={pieceGroups} />
  </div>
</SiteLayout>
